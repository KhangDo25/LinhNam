# MongoDB (bắt buộc) — lib/mongodb.ts, scripts/make-admin.ts
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/linh_nam_db

# JWT session (lib/auth-session.ts):
# - AUTH_SECRET là biến bắt buộc, tối thiểu 32 ký tự.
# - JWT_SECRET là tùy chọn, được ưu tiên hơn AUTH_SECRET nếu có.
AUTH_SECRET=your-random-secret-min-32-chars
JWT_SECRET=your-random-secret-min-32-chars

# URL gốc của site — lib/email.ts dùng để tạo link trong email
NEXTAUTH_URL=http://localhost:3000

# SMTP gửi email (lib/email.ts) — thiếu SMTP_USER/SMTP_PASS thì app vẫn chạy, chỉ không gửi được mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Danh sách email admin, phân cách bằng dấu phẩy (lib/admin-auth.ts)
ADMIN_EMAILS=admin@example.com

